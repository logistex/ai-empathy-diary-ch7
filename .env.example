# AI 공감 다이어리 환경 변수 목록 (이름만 적고 값은 비워 둔다)
# 이 파일을 .env 로 복사해 값을 채운다. .env 는 Git에 올리지 않는다. 비밀 값을 이 파일에 쓰지 않는다.

# Supabase Postgres 연결 문자열. 서버리스(Vercel)에서는 트랜잭션 풀러(포트 6543) 주소를 쓴다. (서버 전용)
DATABASE_URL=

# OpenRouter API 키. AI 감정 분석 호출에 쓴다. (서버 전용)
OPENROUTER_API_KEY=

# Auth.js 세션(JWT) 암호화 키. docs/SETUP.md의 방법(node 또는 openssl)으로 만든다. (서버 전용)
AUTH_SECRET=

# 구글 OAuth 클라이언트 ID. Google Cloud Console에서 만든다.
AUTH_GOOGLE_ID=

# 구글 OAuth 클라이언트 비밀 값. Google Cloud Console에서 만든다. (서버 전용)
AUTH_GOOGLE_SECRET=
